{
  "name": "syda-platform-root",
  "version": "0.1.0",
  "private": true,
  "description": "Syda Platform monorepo orchestrator",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && (uv run uvicorn app.main:app --reload --port 8000 || .venv/bin/uvicorn app.main:app --reload --port 8000)",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "typecheck": "npm --prefix frontend run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
