# Optional: LLM Provider API Keys for Pydantic AI Scenario Agent
# If none are provided, the backend falls back to an intelligent heuristic scenario compiler.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Local development uses ./syda_platform.db when this is unset.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/syda

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Required services for dataset generation: API, Redis, worker, dispatcher.
CELERY_BROKER_URL=redis://localhost:6379/0
# API and worker must use the same key (or the same data/settings volume).
# PROVIDER_ENCRYPTION_KEY=
GENERATION_MAX_ATTEMPTS=3
GENERATION_TIME_LIMIT=3600
GENERATION_LEASE_SECONDS=120
# JOB_DATA_DIR=data/jobs
